# Maintainer: 68RTF
pkgname=veyra
pkgver=0.8.0
pkgrel=1
pkgdesc='Local GTK music player powered by mpv'
arch=('x86_64' 'aarch64')
url='https://github.com/68RTF/veyra'
license=('GPL-3.0-only')
depends=('gtk3' 'mpv' 'ffmpeg' 'curl')
conflicts=('own-player')
makedepends=('cargo' 'pkgconf' 'python')
options=('!debug')
source=("${pkgname}-${pkgver}-source.tar.gz")
sha256sums=("${VEYRA_SOURCE_SHA256:?Build with scripts/build-arch.sh or supply the source archive SHA-256}")

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --release --frozen --bins --message-format=json-render-diagnostics > "$srcdir/artifacts.jsonl"
  python3 scripts/package-licenses.py "$srcdir/artifacts.jsonl" "$srcdir/licenses" "$VEYRA_SOURCE_SHA256" arch
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp -R "$srcdir/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm755 "${srcdir}/target/release/veyra" "${pkgdir}/usr/bin/veyra"
  install -Dm755 "${srcdir}/target/release/ym-export" "${pkgdir}/usr/bin/ym-export"
  install -Dm644 veyra.desktop "${pkgdir}/usr/share/applications/veyra.desktop"
  install -Dm644 assets/veyra.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/veyra.svg"
}
